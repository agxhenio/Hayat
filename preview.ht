<!DOCTYPE html>
<html lang="sq">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Hayat Design System</title>
  
  <link rel="stylesheet" href="css/main.css">
  
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* Specific styles just for the documentation layout */
    .docs-container { padding: var(--space-6) var(--space-4) calc(var(--space-20) * 2); max-width: 800px; margin: 0 auto; }
    .docs-section { margin-bottom: var(--space-12); }
    .docs-title { color: var(--color-accent-gold); margin-bottom: var(--space-6); padding-bottom: var(--space-2); border-bottom: 1px solid var(--color-divider); }
    .docs-row { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-bottom: var(--space-4); align-items: center; }
    
    /* Floating Theme Toggle */
    .theme-toggle { position: fixed; top: var(--space-4); right: var(--space-4); z-index: var(--z-fixed); }
  </style>
</head>
<body>

  <button class="btn btn--secondary btn--icon theme-toggle" id="themeToggler" onclick="toggleTheme()">
    <i data-lucide="moon"></i>
  </button>

  <div class="docs-container animate-fade-in">
    
    <header class="docs-section">
      <h1>Hayat (حياة)</h1>
      <p>Sistemi i Dizajnit / Design System Foundation</p>
      <div class="badge badge--gold">Version 1.0</div>
    </header>

    <section class="docs-section">
      <h2 class="docs-title">1. Tipografia</h2>
      <h1>Heading 1 (Inter Bold)</h1>
      <h2>Heading 2</h2>
      <h3>Heading 3</h3>
      <p>Paragrafi normal. Zoti jep, e Zoti merr. Ky aplikacion është për komunitetin Shqiptar.</p>
      
      <div class="card card--elevated">
        <p class="arabic-ui" style="font-size: var(--font-size-ar-sm); margin: 0;">بسم الله الرحمن الرحيم</p>
        <p class="arabic-quran" style="font-size: var(--font-size-ar-lg); margin-top: var(--space-2);">ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ</p>
      </div>
    </section>

    <section class="docs-section">
      <h2 class="docs-title">2. Butonat</h2>
      <div class="docs-row">
        <button class="btn btn--primary">Primary (Gold)</button>
        <button class="btn btn--secondary">Secondary (Teal)</button>
        <button class="btn btn--ghost">Ghost</button>
      </div>
      <div class="docs-row">
        <button class="btn btn--primary btn--sm">Small</button>
        <button class="btn btn--primary btn--lg">Large Button</button>
        <button class="btn btn--secondary btn--icon"><i data-lucide="play"></i></button>
        <button class="btn btn--primary" disabled>Disabled</button>
      </div>
    </section>

    <section class="docs-section">
      <h2 class="docs-title">3. Kartat (Cards)</h2>
      <div class="docs-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
        <div class="card card--elevated">
          <h3>Karta Normale</h3>
          <p>Elevated me shadow.</p>
        </div>
        <div class="card card--gradient">
          <h3>Karta Gradient</h3>
          <p>Theks i veçantë me border.</p>
        </div>
      </div>
    </section>

    <section class="docs-section">
      <h2 class="docs-title">4. Format (Inputs)</h2>
      <div class="input-group">
        <label>Emri</label>
        <input type="text" class="input" placeholder="Shkruaj emrin tënd...">
      </div>
      <div class="input-group">
        <label>Kërko</label>
        <div class="input-wrapper">
          <i data-lucide="search" class="input-icon"></i>
          <input type="text" class="input input--with-icon" placeholder="Kërko sure...">
        </div>
      </div>
    </section>

    <section class="docs-section">
      <h2 class="docs-title">5. Badges & Avatars</h2>
      <div class="docs-row">
        <span class="badge badge--success">E kryer</span>
        <span class="badge badge--warning">Së shpejti</span>
        <span class="badge badge--danger">E humbur</span>
        <span class="badge badge--gold">Premium</span>
      </div>
      <div class="docs-row">
        <div class="avatar avatar--sm">S</div>
        <div class="avatar avatar--md">SÇ</div>
        <div class="avatar avatar--lg"><i data-lucide="user"></i></div>
      </div>
    </section>

    <section class="docs-section">
      <h2 class="docs-title">6. Listat & Progresi</h2>
      <div class="card card--elevated">
        <div class="list-item">
          <div class="list-item__icon"><i data-lucide="sun"></i></div>
          <div class="list-item__content">
            <div class="list-item__title">Sabahu</div>
            <div class="list-item__subtitle">04:32 AM</div>
          </div>
          <i data-lucide="chevron-right" style="color: var(--color-text-tertiary);"></i>
        </div>
        <div class="list-item">
          <div class="list-item__icon"><i data-lucide="book-open"></i></div>
          <div class="list-item__content">
            <div class="list-item__title">Lexo Kuran</div>
            <div class="list-item__subtitle">Surah Al-Kahf</div>
          </div>
        </div>
      </div>

      <div class="docs-row" style="margin-top: var(--space-6);">
        <div class="progress-circle">
          <svg width="80" height="80">
            <circle class="progress-circle__bg" cx="40" cy="40" r="32"></circle>
            <circle class="progress-circle__value" cx="40" cy="40" r="32" stroke-dasharray="200" stroke-dashoffset="50"></circle>
          </svg>
          <span class="progress-circle__text">75%</span>
        </div>
        
        <div class="spinner--islamic"></div>
      </div>
    </section>

    <section class="docs-section">
      <h2 class="docs-title">7. UI Controls</h2>
      <div class="segmented">
        <button class="segmented__btn is-active">Shqip</button>
        <button class="segmented__btn">Arabisht</button>
      </div>
      
      <div class="tabs" style="margin-top: var(--space-6);">
        <div class="tab is-active">Të gjitha</div>
        <div class="tab">Mëngjesi</div>
        <div class="tab">Mbrëmja</div>
        <div class="tab">Pas Namazit</div>
      </div>
    </section>
  </div>

  <nav class="nav-bar">
    <div class="nav-item is-active">
      <i data-lucide="home"></i>
      <span>Kreu</span>
    </div>
    <div class="nav-item">
      <i data-lucide="book-open"></i>
      <span>Kurani</span>
    </div>
    <div class="nav-item">
      <i data-lucide="compass"></i>
      <span>Kibla</span>
    </div>
    <div class="nav-item">
      <i data-lucide="settings"></i>
      <span>Cilësimet</span>
    </div>
  </nav>

  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // Theme Toggle Logic
    let isDark = true;
    function toggleTheme() {
      isDark = !isDark;
      document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
      
      const icon = document.querySelector('.theme-toggle i');
      icon.setAttribute('data-lucide', isDark ? 'moon' : 'sun');
      lucide.createIcons();
    }
  </script>
</body>
</html>
